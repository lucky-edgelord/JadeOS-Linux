#!/bin/sh
# jade-wifi SSID PASSWORD  - join a Wi-Fi network (saved on the data partition, used on every boot)
[ $# -eq 2 ] || { echo "usage: jade-wifi SSID PASSWORD"; exit 2; }
mkdir -p /data/etc
# (this build has no wpa_passphrase and no control socket, so the file is just the network block)
printf 'network={\n  ssid="%s"\n  scan_ssid=1\n  psk="%s"\n}\n' "$1" "$2" > /data/etc/wpa_supplicant.conf
chmod 600 /data/etc/wpa_supplicant.conf
# replace a running connection (an old password would otherwise stay in use until reboot)
/etc/init.d/S41wifi stop; killall -q wpa_supplicant; sleep 1
for f in /run/udhcpc.wl*.pid; do [ -f "$f" ] && kill "$(cat "$f")" 2>/dev/null; done
/etc/init.d/S41wifi start
echo "Saved. Connecting to $1 ..."; sleep 8
W=$(for d in /sys/class/net/*; do [ -d "$d/wireless" ] && echo "${d##*/}" && break; done)
ifconfig "$W" 2>/dev/null | grep -q 'inet addr' && echo "Connected: $(ifconfig "$W" | sed -n 's/.*inet addr:\([^ ]*\).*/\1/p')" || echo "Not connected yet. Check the name and password (Wi-Fi names are case-sensitive)."
