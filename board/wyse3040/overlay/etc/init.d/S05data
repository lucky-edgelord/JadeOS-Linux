#!/bin/sh
# Mount the data partition (label "jadedata") on /data, grow it to fill the disk on first boot, and bind
# /data/home onto /home. If there is no data partition (or it will not mount) /home is RAM and nothing is saved.
case "$1" in
  start)
    DEV=$(findfs LABEL=jadedata 2>/dev/null)
    [ -n "$DEV" ] || DEV=$(blkid 2>/dev/null | sed -n 's|^\(/dev/[^:]*\):.*LABEL="jadedata".*|\1|p' | head -n1)
    if [ -z "$DEV" ]; then   # last resort: read the ext4 label straight from the superblock
      for sys in /sys/class/block/*/partition; do
        n=$(basename "$(dirname "$sys")")
        [ "$(dd if=/dev/$n bs=1 skip=1144 count=8 2>/dev/null)" = "jadedata" ] && DEV=/dev/$n && break
      done
    fi
    if [ -n "$DEV" ]; then
      grown=0
      if mount -o ro "$DEV" /data 2>/dev/null; then [ -e /data/.grown ] && grown=1; umount /data; fi
      if [ "$grown" = 0 ]; then
        case "$DEV" in
          *mmcblk*[0-9]p[0-9]*|*nvme*p[0-9]*) DISK=${DEV%p[0-9]*}; PART=${DEV##*p} ;;
          *) DISK=${DEV%%[0-9]*}; PART=${DEV##*[a-z]} ;;
        esac
        echo "jadeos: growing $DEV to fill $DISK"
        START=$(sgdisk -i "$PART" "$DISK" 2>/dev/null | sed -n 's/^First sector: \([0-9]*\).*/\1/p')
        if [ -n "$START" ] && sgdisk -e "$DISK" >/dev/null 2>&1 \
           && sgdisk -d "$PART" -n "$PART:$START:0" -t "$PART:8300" -c "$PART:data" "$DISK" >/dev/null 2>&1; then
          partx -u "$DISK" 2>/dev/null; sleep 1
          e2fsck -fp "$DEV" >/dev/null 2>&1; resize2fs "$DEV" >/dev/null 2>&1
        else echo "jadeos: could not grow the data partition (continuing)"; fi
      fi
      e2fsck -p "$DEV" >/dev/null 2>&1
      if mount -o noatime "$DEV" /data; then
        touch /data/.grown
        mkdir -p /data/home/jade /data/etc
        mount --bind /data/home /home
        echo "jadeos: data on $DEV"
        exit 0
      fi
    fi
    echo "jadeos: NO PERSISTENT DATA - /home is RAM, nothing will be saved"
    mount -t tmpfs -o mode=0755 tmpfs /home; mkdir -p /home/jade /data/etc 2>/dev/null
    mount -t tmpfs tmpfs /data 2>/dev/null; mkdir -p /data/etc
    ;;
  stop) sync; umount /home 2>/dev/null; umount /data 2>/dev/null ;;
esac
